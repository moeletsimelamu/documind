# Copy to backend/.env (git-ignored) and adjust. Every setting is optional.

# Where the database and uploaded files are stored (relative to the working directory).
DOCUMIND_DATA_DIR=data

# Limits
DOCUMIND_MAX_UPLOAD_MB=20
DOCUMIND_MAX_PDF_PAGES=500
DOCUMIND_MAX_EXTRACTED_CHARS=2000000
DOCUMIND_MAX_CONCURRENT_PROCESSING=2

# Optional AI answers through any OpenAI-compatible chat API.
# Leave DOCUMIND_LLM_MODEL empty to keep AI answers off; search and documents still work.
DOCUMIND_LLM_MODEL=
DOCUMIND_LLM_BASE_URL=https://api.openai.com/v1
# A local server such as Ollama usually needs no key:
#   DOCUMIND_LLM_BASE_URL=http://localhost:11434/v1
DOCUMIND_LLM_API_KEY=
DOCUMIND_LLM_TIMEOUT_SECONDS=30
DOCUMIND_LLM_MAX_OUTPUT_TOKENS=700

DOCUMIND_LOG_LEVEL=INFO
DOCUMIND_API_DOCS=true
