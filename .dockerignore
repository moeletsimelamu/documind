# Only what the image needs: backend source and pins, frontend source. Never data or secrets.
.git
.github
docs
**/__pycache__
**/*.pyc

# Secrets and local configuration
.env
.env.*
**/.env

# Runtime data: uploaded documents and databases
backend/data
**/*.db
**/*.db-wal
**/*.db-shm

# Local environments and build output
backend/.venv
backend/tests
backend/.pytest_cache
backend/.mypy_cache
backend/.ruff_cache
frontend/node_modules
frontend/dist
frontend/.angular
frontend/e2e
frontend/test-results
frontend/playwright-report
